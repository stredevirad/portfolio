{
  "name": "jhj-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio of Joshua Herbert Japheth — AI that knows when to say 'I don't know'.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:app": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "build:post": "node scripts/postbuild.mjs",
    "build": "npm run typecheck && npm run build:app && npm run build:post",
    "preview": "node scripts/serve.mjs 4173",
    "images": "node scripts/optimize-images.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "lighthouse": "node scripts/lighthouse.mjs",
    "size": "node scripts/size.mjs",
    "serve": "node scripts/serve.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "*",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "chrome-launcher": "^1.2.3",
    "lighthouse": "^13.6.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
